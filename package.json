{
  "name": "mistral",
  "description": "Mistral - Tailwind CSS + Alpine JS landing page",
  "version": "1.1.2",
  "license": "UNLICENCED",
  "private": "true",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview --open",
    "test": "run-p test:*",
    "test:lint": "run-s lint:eslint lint:stylelint lint:prettier",
    "lint": "run-s lint:eslint:fix lint:stylelint:fix lint:prettier:fix",
    "lint:prettier": "prettier --check \"./src/**/*.(js|css|pcss|postcss|html)\"",
    "lint:prettier:fix": "prettier --write \"./src/**/*.(js|css|pcss|postcss|html)\"",
    "lint:eslint": "eslint --ext .js ./src",
    "lint:eslint:fix": "eslint --fix --ext .js ./src",
    "lint:stylelint": "stylelint ./src/**/*.{css,pcss,postcss}",
    "lint:stylelint:fix": "stylelint ./src/**/*.{css,pcss,postcss} --fix"
  },
  "dependencies": {
    "@alpinejs/collapse": "3.12.3",
    "@alpinejs/intersect": "3.12.3",
    "@alpinejs/persist": "3.12.3",
    "@iconify/iconify": "3.1.1",
    "alpinejs": "3.12.3",
    "lit": "2.7.6",
    "media-icons": "^0.10.0",
    "prism-theme-vars": "0.2.4",
    "prismjs": "1.29.0",
    "swiper": "10.0.4",
    "vidstack": "0.6.13"
  },
  "devDependencies": {
    "@iconify/json": "2.2.95",
    "@tailwindcss/aspect-ratio": "0.4.2",
    "@tailwindcss/forms": "0.5.4",
    "@tailwindcss/line-clamp": "0.4.4",
    "@tailwindcss/typography": "0.5.9",
    "autoprefixer": "10.4.14",
    "chalk": "5.3.0",
    "cssnano": "6.0.1",
    "eslint": "8.46.0",
    "eslint-config-prettier": "8.9.0",
    "fast-glob": "3.3.1",
    "hint": "7.1.10",
    "lint-staged": "13.2.3",
    "npm-run-all": "4.1.5",
    "postcss": "8.4.27",
    "postcss-class-name-shortener": "2.0.0",
    "prettier": "3.0.0",
    "stylelint": "15.10.2",
    "stylelint-config-prettier": "9.0.5",
    "stylelint-config-standard": "34.0.0",
    "tailwindcss": "3.3.3",
    "vite": "4.4.7",
    "vite-plugin-handlebars": "1.6.0",
    "vite-plugin-purge-icons": "0.9.2",
    "yorkie": "2.0.0"
  },
  "gitHooks": {
    "pre-commit": "lint-staged",
    "commit-msg": "node scripts/verifyCommit.js"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint",
      "prettier --write"
    ],
    "*.pcss": [
      "stylelint",
      "prettier --write"
    ],
    "*.postcss": [
      "stylelint",
      "prettier --write"
    ],
    "*.html": [
      "prettier --write"
    ]
  }
}
