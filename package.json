{
  "name": "mistral",
  "description": "Mistral - Tailwind CSS + Alpine JS landing page",
  "version": "1.3.0",
  "license": "MIT",
  "private": "true",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview --open",
    "test": "run-p test:*",
    "test:lint": "run-s lint:eslint lint:stylelint lint:prettier",
    "lint": "run-s lint:eslint:fix lint:stylelint:fix lint:prettier:fix",
    "lint:prettier": "prettier --check \"./src/**/*.(js|css|pcss|postcss|html)\"",
    "lint:prettier:fix": "prettier --write \"./src/**/*.(js|css|pcss|postcss|html)\"",
    "lint:eslint": "eslint --ext .js ./src",
    "lint:eslint:fix": "eslint --fix --ext .js ./src",
    "lint:stylelint": "stylelint ./src/**/*.{css,pcss,postcss}",
    "lint:stylelint:fix": "stylelint ./src/**/*.{css,pcss,postcss} --fix"
  },
  "dependencies": {
    "@alpinejs/collapse": "3.13.10",
    "@alpinejs/intersect": "3.13.10",
    "@alpinejs/persist": "3.13.10",
    "iconify-icon": "^2.0.0",
    "alpinejs": "3.13.10",
    "lit": "2.7.6",
    "media-icons": "^0.10.0",
    "prism-theme-vars": "0.2.5",
    "prismjs": "1.29.0",
    "swiper": "11.1.1",
    "vidstack": "0.6.13"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "0.4.2",
    "@tailwindcss/forms": "0.5.7",
    "@tailwindcss/line-clamp": "0.4.4",
    "@tailwindcss/typography": "0.5.13",
    "autoprefixer": "10.4.19",
    "chalk": "5.3.0",
    "cssnano": "7.0.1",
    "eslint": "9.1.1",
    "eslint-config-prettier": "9.1.0",
    "fast-glob": "3.3.2",
    "hint": "7.1.11",
    "lint-staged": "15.2.2",
    "npm-run-all": "4.1.5",
    "postcss": "8.4.38",
    "postcss-class-name-shortener": "2.0.0",
    "prettier": "3.2.5",
    "stylelint": "16.4.0",
    "stylelint-config-prettier": "9.0.5",
    "stylelint-config-standard": "36.0.0",
    "tailwindcss": "3.4.3",
    "vite": "5.2.10",
    "vite-plugin-handlebars": "1.6.0",
    "yorkie": "2.0.0"
  },
  "gitHooks": {
    "pre-commit": "lint-staged",
    "commit-msg": "node scripts/verifyCommit.js"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint",
      "prettier --write"
    ],
    "*.pcss": [
      "stylelint",
      "prettier --write"
    ],
    "*.postcss": [
      "stylelint",
      "prettier --write"
    ],
    "*.html": [
      "prettier --write"
    ]
  }
}
